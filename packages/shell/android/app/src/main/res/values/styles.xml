<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      The window the WebView lives in. The system bars take the document's own background
      (app_background = the token layer's -color-bg) with light icons, so on Android 14 and
      earlier, where the bars are painted, they continue the page rather than framing it; on
      Android 15+ the bars are transparent and drawn over, and the web app pads itself with the
      insets Capacitor's SystemBars plugin exposes (capacitor.config.ts).
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      The launch window. Android 12+ draws the system splash — the launcher icon on
      windowSplashScreenBackground — and the drawable is what Android 11 and earlier show; both
      are the product's background with its mark, generated by tools/generate-assets.mjs.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
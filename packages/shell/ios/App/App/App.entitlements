<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links: every https link to the site's origin opens the shell once
	     packages/web/public/.well-known/apple-app-site-association carries the Team ID. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:thp.indepthwebsolutions.com</string>
	</array>
	<!-- Push (project prd 3.17.1, 5.2.5). `production` is what an App Store or TestFlight build
	     must carry; Xcode rewrites it to `development` for a build it installs directly, and the
	     server's APNS_ENVIRONMENT=sandbox is the matching half for testing such a build. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>

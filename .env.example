# Copy to .env and adjust. Nothing in the repository reads a default for these.

# Postgres. The instance must have the `vector` extension AVAILABLE (installed as a package) and
# NOT enabled — slice 01 asserts both. See README.md, "Database".
DATABASE_URL=postgres://thp:thp@127.0.0.1:5432/thp

# The absolute origin the client calls. There is no same-host fallback by design: the packaged
# mobile build later changes this one value and nothing else.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3000

# The first admin, created by `npm run seed:admin`. The command refuses a weak or absent password
# rather than seeding a guessable account, and running it again leaves an existing account — and its
# password — untouched. Not read anywhere else.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_DISPLAY_NAME=First Admin
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Transactional email. Two messages so far: the invitation and the password-reset link. Both go
# through one adapter, so adding a third is a template rather than a configuration change.
#
# The adapter speaks SMTP and names no vendor, so moving between Resend, Postmark, a Fastmail
# mailbox and a self-hosted relay is these four values rather than a change of code. The values
# below are Resend's, which is what this deployment sends through: the user is the literal word
# `resend` and the password is an API key from https://resend.com/api-keys.
#
# `smtp` is the only transport a deployment should ever name. `capture` writes each message to
# MAIL_CAPTURE_PATH as JSON lines instead of sending it — that is what `npm test` uses, and what
# lets you open the real rendered invitation in a browser during development. `failing` refuses
# everything and exists only so the suite can drive a send failure.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=resend
MAIL_PASSWORD=
# The sender every message goes out as. The domain must be one you have verified with the
# provider, or the mail will be rejected or filed as spam — see README.md, "Email".
MAIL_FROM=Teaching Hub <invitations@example.com>
# Only read when MAIL_TRANSPORT=capture. Keep it under .tmp/, which is gitignored: a captured
# invitation or reset message contains a working token.
MAIL_CAPTURE_PATH=.tmp/mail/outbox.jsonl

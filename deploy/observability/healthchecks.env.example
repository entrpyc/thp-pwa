# /etc/thp/healthchecks.env — **the three Healthchecks.io ping URLs the scheduled jobs report to.**
#
# A check on Healthchecks.io is a URL the job pings when it finishes; the service alerts when the
# ping does not arrive. These three cover the nightly backup, the daily archive check and the
# restore drill (docs/project/observability.md § 2.4, alerts A6 and A7). The worker's own heartbeat
# URL is not here — it is `HEALTHCHECK_WORKER_URL` in the application's `.env`, because the worker
# is the one process that reads `.env` and the systemd units are not.
#
# Read by systemd for the two backup units (`EnvironmentFile=`) and by scripts/restore-drill.sh,
# which runs as the service user — so: root-owned, group `thp`, mode 640.
#
#   sudo install -d -o root -g root -m 755 /etc/thp
#   sudo install -o root -g thp -m 640 deploy/observability/healthchecks.env.example /etc/thp/healthchecks.env
#
# then fill in the three URLs from the checks created in README.md "Monitoring". A URL that is
# missing or empty means that job pings nothing; the unit still succeeds (the ping line is marked
# `-`), and `verify:production`'s `backup-pings` check is what notices the gap.

HEALTHCHECK_BACKUP_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
HEALTHCHECK_BACKUP_CHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
HEALTHCHECK_RESTORE_DRILL_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

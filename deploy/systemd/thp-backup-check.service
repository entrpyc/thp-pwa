# `pgbackrest check` — does the archive command actually work, and is the repository reachable?
#
# Separate from the backup itself and run daily, because **an archive that silently stopped is the
# failure this whole group exists to prevent**. A nightly full that succeeds tells you nothing
# about whether WAL has been reaching the repository in between, and the gap between "the archive
# broke" and "somebody noticed" is exactly the window a restore would come up short in.

[Unit]
Description=pgBackRest check of the thp stanza
Requires=postgresql.service
After=postgresql.service network-online.target

[Service]
Type=oneshot
User=postgres
ExecStart=/usr/bin/pgbackrest --stanza=thp check
# Tell Healthchecks.io the check passed (docs/project/observability.md § 2.4, alert A6). Runs only
# after a successful ExecStart; a failed check pings nothing and the missing ping is the alert. The
# URL comes from /etc/thp/healthchecks.env — deploy/observability/healthchecks.env.example.
EnvironmentFile=-/etc/thp/healthchecks.env
ExecStartPost=-/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null ${HEALTHCHECK_BACKUP_CHECK_URL}

[Install]
WantedBy=multi-user.target

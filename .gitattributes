# The deployment scripts run on Linux and are authored on Windows. A CRLF checkout breaks the
# shebang with `bad interpreter: /usr/bin/env bash^M`, which is a confusing way to lose an hour on
# the box — so these are LF regardless of anyone's core.autocrlf.
*.sh text eol=lf
.githooks/* text eol=lf

# The Gradle wrapper is a shell script with no extension, run on whichever Mac or Linux box builds
# the Android bundle — the same CRLF hazard as the deployment scripts above.
packages/shell/android/gradlew text eol=lf
